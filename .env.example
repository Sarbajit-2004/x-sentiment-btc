# Copy this file to .env and fill in the two keys. .env is git-ignored - never commit it.

# --- required -----------------------------------------------------------------
# Apify console -> Settings -> API & Integrations -> Personal API token
APIFY_TOKEN=
# app.tavily.com -> API key (starts with tvly-)
TAVILY_API_KEY=

# --- X scraping (Apify) -------------------------------------------------------
# Default actor: kaitoeasyapi/twitter-x-data-tweet-scraper-pay-per-result-cheapest (~$0.25 / 1k tweets)
# Alternatives already supported: apidojo/tweet-scraper (~$0.40 / 1k, needs a paid Apify plan for API use)
#                                 altimis/scweet       (~$0.30 / 1k, 3,000-tweet free trial)
APIFY_ACTOR_ID=kaitoeasyapi/twitter-x-data-tweet-scraper-pay-per-result-cheapest
# 180 days x 80 tweets = 14,400 tweets ~= $3.60 on the default actor (Apify free plan = $5 / month)
LOOKBACK_DAYS=180
TWEETS_PER_WINDOW=80
WINDOW_HOURS=24
APIFY_QUERY_TYPE=Top
APIFY_CONCURRENCY=3
# hard spending cap per actor run, in USD
APIFY_MAX_CHARGE_USD=0.5
X_QUERY='(bitcoin OR BTC OR $BTC OR #bitcoin OR #BTC)'

# --- asset / news ---------------------------------------------------------------
ASSET_NAME=Bitcoin
PRICE_TICKER=BTC-USD
NEWS_TIME_RANGE=week
NEWS_QUERIES=Bitcoin price news|Bitcoin ETF flows|Bitcoin regulation SEC|crypto market outlook Bitcoin

# --- modelling ------------------------------------------------------------------
MIN_TRAIN_DAYS=60
REFIT_EVERY=1
COST_BPS=10
ALLOW_SHORT=false
SENTIMENT_ENGINE=vader
